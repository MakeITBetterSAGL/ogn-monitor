[Unit]
Description=OGN Monitor packet parser
After=ogn-collector.service
Requires=ogn-collector.service

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=@INSTALL_DIR@/.env
ExecStart=@INSTALL_DIR@/.venv/bin/python @INSTALL_DIR@/parser.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
