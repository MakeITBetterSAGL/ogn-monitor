# Copy this file to docker.env before starting Docker Compose.
OGN_STATION_NAME="My OGN Station"
OGN_STATION_LATITUDE="0.000000"
OGN_STATION_LONGITUDE="0.000000"
OGN_TIMEZONE="UTC"

# The decoder remains on the Docker host. It must accept connections from the
# Docker bridge, not only from 127.0.0.1.
OGN_DECODER_HOST="host.docker.internal"
OGN_DECODER_PORT="50001"

OGN_ACTIVE_MINUTES="10"
OGN_TRACK_MINUTES="30"
OGN_ONLINE_SECONDS="120"
OGN_SESSION_GAP_MINUTES="20"
OGN_PARSER_POLL_SECONDS="2"

# Optional recording filters. Leave blank to disable a filter. Altitudes are
# metres above mean sea level (AMSL).
OGN_FILTER_MAX_RADIUS_KM=""
OGN_FILTER_MIN_ALTITUDE_M=""
OGN_FILTER_MAX_ALTITUDE_M=""
OGN_RETENTION_DAYS="365"

# Host port used to open the dashboard. The container always listens on 5000.
OGN_HTTP_PORT="5000"

# Refresh the public OGN Devices Database once per day. Set to 0 to disable.
OGN_DDB_REFRESH_SECONDS="86400"
