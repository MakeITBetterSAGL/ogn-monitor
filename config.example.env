# Copy this file to .env and set the values for your station.
OGN_STATION_NAME="My OGN Station"
OGN_STATION_LATITUDE="0.000000"
OGN_STATION_LONGITUDE="0.000000"
OGN_TIMEZONE="UTC"

# Local TCP output exposed by the OGN decoder.
OGN_DECODER_HOST="127.0.0.1"
OGN_DECODER_PORT="50001"

# Dashboard and history behaviour.
OGN_ACTIVE_MINUTES="10"
OGN_TRACK_MINUTES="30"
OGN_ONLINE_SECONDS="120"
OGN_SESSION_GAP_MINUTES="20"
OGN_PARSER_POLL_SECONDS="2"

# The public edition intentionally serves plain HTTP on port 5000.
OGN_WEB_HOST="0.0.0.0"
OGN_WEB_PORT="5000"
